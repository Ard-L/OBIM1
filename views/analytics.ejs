<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analytics</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<% const fmt = n => Number(n).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); %>

<%- include('partials/admin-header', { active: 'analytics' }) %>

<main class="container">
    <div class="page-header">
        <h1>Analytics</h1>
        <p>Overview of customers, balances and activity.</p>
    </div>

    <div class="stat-grid">
        <div class="stat"><span>Customers</span><h3><%= summary.customers %></h3></div>
        <div class="stat"><span>Accounts</span><h3><%= summary.accounts %></h3></div>
        <div class="stat"><span>Pending Approvals</span><h3><%= summary.pending %></h3></div>
        <div class="stat"><span>Total Balance</span><h3>₱<%= fmt(summary.total_balance) %></h3></div>
        <div class="stat"><span>Total Deposits</span><h3>₱<%= fmt(totals.deposits) %></h3></div>
        <div class="stat"><span>Total Withdrawals</span><h3>₱<%= fmt(totals.withdrawals) %></h3></div>
        <div class="stat"><span>Transactions</span><h3><%= totals.cnt %></h3></div>
        <div class="stat"><span>Bills Paid</span><h3>₱<%= fmt(billTotal) %></h3></div>
    </div>

    <section class="card">
        <h2>Last 14 Days</h2>
        <div class="legend">
            <span><i style="background: var(--gold-500)"></i>Deposits</span>
            <span><i style="background: var(--red-600)"></i>Withdrawals</span>
        </div>
        <div class="chart">
            <% days.forEach(d => { %>
            <div class="day" title="<%= d.label %> — Deposits ₱<%= fmt(d.deposits) %> / Withdrawals ₱<%= fmt(d.withdrawals) %>">
                <div class="pair">
                    <div class="bar dep" style="height: <%= d.dPct %>%"></div>
                    <div class="bar wd" style="height: <%= d.wPct %>%"></div>
                </div>
            </div>
            <% }) %>
        </div>
        <div class="chart-labels">
            <% days.forEach(d => { %><span><%= d.label %></span><% }) %>
        </div>
    </section>

    <div class="two-col">
        <section class="card">
            <h2>Balance by Account Type</h2>
            <% if (types.length === 0) { %><p class="empty">No accounts yet.</p><% } %>
            <% types.forEach(t => { %>
            <div class="hbar">
                <div class="hbar-top"><span><%= t.account_type %> (<%= t.cnt %>)</span><strong>₱<%= fmt(t.total) %></strong></div>
                <div class="track"><div class="fill gold" style="width: <%= t.pct %>%"></div></div>
            </div>
            <% }) %>
        </section>

        <section class="card">
            <h2>Bill Payments by Biller</h2>
            <% if (bills.length === 0) { %><p class="empty">No bill payments yet.</p><% } %>
            <% bills.forEach(b => { %>
            <div class="hbar">
                <div class="hbar-top"><span><%= b.biller %> (<%= b.cnt %>)</span><strong>₱<%= fmt(b.total) %></strong></div>
                <div class="track"><div class="fill" style="width: <%= b.pct %>%"></div></div>
            </div>
            <% }) %>
        </section>
    </div>

    <section class="card">
        <h2>Top Accounts by Balance</h2>
        <div class="table-container">
            <table>
                <thead><tr><th>#</th><th>Customer</th><th>Account</th><th>Balance</th></tr></thead>
                <tbody>
                    <% if (top.length === 0) { %><tr><td colspan="4" class="empty">No accounts yet.</td></tr><% } %>
                    <% top.forEach((t, i) => { %>
                    <tr>
                        <td><%= i + 1 %></td>
                        <td><strong><%= t.first_name %> <%= t.last_name %></strong></td>
                        <td><%= t.account_number %></td>
                        <td class="money">₱<%= fmt(t.balance) %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </section>
</main>
</body>
</html>
